      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reconciling invariants (every load):\n  \u2022 net worth == assets \u2212 debts (+ receivable)\n  \u2022 total assets \u2265 net worth\n  \u2022 duplicate-detect: acct+merchant+amt \u22642d\n  \u2022 stale / phantom holdings \u00b7 stale feeds\n  \u2022 balance \u2194 transactions reconcile\n\nclassification (transfers \u00b7 finance_rules \u00b7\naccount_classify) feeds features.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconciling invariants (every load):\n  \u2022 net worth == assets \u2212 debts (+ receivable)\n  \u2022 total assets \u2265 net worth\n  \u2022 duplicate-detect: acct+merchant+amt \u22642d\n  \u2022 stale / phantom holdings \u00b7 stale feeds\n  \u2022 balance \u2194 transactions reconcile\n\nclassification (transfers \u00b7 finance_rules \u00b7\naccount_classify) feeds features.",
      "lineHeight": 1.25,
      "baseline": 12
    },
