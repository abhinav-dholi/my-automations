      "updated": 1,
      "link": null,
      "locked": false,
      "text": "CASH WATERFALL (typical month):\n  take-home \u2212 spend + net reimbursements\n  = OPERATING CASH SURPLUS\n  (401k \u00b7 one-time \u00b7 savings-transfers: separate)\n\nNET WORTH = \u03a3 effective acct value\n  \u2212 debts + Splitwise receivable\nallocation \u00b7 concentration \u00b7 emergency fund",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CASH WATERFALL (typical month):\n  take-home \u2212 spend + net reimbursements\n  = OPERATING CASH SURPLUS\n  (401k \u00b7 one-time \u00b7 savings-transfers: separate)\n\nNET WORTH = \u03a3 effective acct value\n  \u2212 debts + Splitwise receivable\nallocation \u00b7 concentration \u00b7 emergency fund",
      "lineHeight": 1.25,
      "baseline": 12
    },
