#!/usr/bin/env python3
"""`auto` — single front door for all automations.

Commands:
  auto list             List automations, triggers, schedules.
  auto run <id>         Resolve secrets, run the automation now.
  auto ui               Launch the Streamlit dashboard (Phase 5).
  auto deploy <id>      (stub) Generate the cloud trigger.
  auto skills           (stub) Generate Claude Code skill wrappers.

Secrets declared in a manifest are resolved in THIS process (one Keychain
touch) and injected into the child as env vars; the child re-reads them via
secrets_store (which also registers them for scrubbing).
"""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
LIB_PY = REPO_ROOT / "lib" / "py"
sys.path.insert(0, str(LIB_PY))

import manifest as manifest_mod  # noqa: E402
import runlog  # noqa: E402
import secrets_store  # noqa: E402


def _by_category(rows):
    cats: dict[str, list] = {}
    for m in rows:
        cats.setdefault(m.category, []).append(m)
    return dict(sorted(cats.items()))


def cmd_list(args) -> int:
    rows = manifest_mod.discover()
    if getattr(args, "category", None):
        rows = [m for m in rows if m.category == args.category]
    if not rows:
        print("No automations. Create automations/<id>/automation.yaml")
        return 0
    for cat, items in _by_category(rows).items():
        print(f"\n▸ {cat}")
        print(f"  {'ID':<20} {'RUNTIME':<8} {'TRIGGERS':<22} {'SCHEDULE':<13} DEPLOY")
        for m in items:
            print(f"  {m.id:<20} {m.runtime:<8} {','.join(m.triggers):<22} "
                  f"{(m.schedule or '-'):<13} {m.deploy_target}")
    return 0


def cmd_status(args) -> int:
    import service
    rows = manifest_mod.discover()
    if getattr(args, "category", None):
        rows = [m for m in rows if m.category == args.category]
    latest = {}
    for rec in runlog.read_recent(500):
        latest[rec["id"]] = rec
    for cat, items in _by_category(rows).items():
        print(f"\n▸ {cat}")
        print(f"  {'ID':<20} {'SERVICE':<14} {'PID':<8} {'LAST RUN':<14} STATUS")
        for m in items:
            if not m.managed:
                svc, pid = "on-demand", "-"
            else:
                loaded = service.is_loaded(m.id)
                svc = "running" if loaded else "stopped"
                pid = service.pid(m.id) or "-" if loaded else "-"
            last = latest.get(m.id, {})
            print(f"  {m.id:<20} {svc:<14} {str(pid):<8} "
                  f"{last.get('status','-'):<14} {last.get('end','-')}")
    return 0


def _targets(spec: str):
    """Resolve an id, a category name, or 'all' to a list of managed manifests."""
    rows = [m for m in manifest_mod.discover() if m.managed]
    if spec == "all":
        return rows
    by_cat = [m for m in rows if m.category == spec]
    if by_cat:
        return by_cat
    return [m for m in rows if m.id == spec]


def cmd_start(args) -> int:
    import service
    targets = _targets(args.target)
    if not targets:
        print(f"No managed automation/category matching '{args.target}'.")
        return 1
    for m in targets:
        ok, err = service.install(m)
        print(f"{'✅' if ok else '⚠️ '} start {m.id}" + (f"  ({err})" if err and not ok else ""))
    return 0


def cmd_stop(args) -> int:
    import service
    targets = _targets(args.target)
    if not targets:
        print(f"No managed automation/category matching '{args.target}'.")
        return 1
    for m in targets:
        ok = service.uninstall(m.id)
        print(f"{'✅' if ok else '⚠️ '} stop {m.id}")
    return 0


def cmd_restart(args) -> int:
    cmd_stop(args)
    return cmd_start(args)


def cmd_logs(args) -> int:
    import config as cfg
    base = cfg.LOGS_DIR
    shown = False
    for suffix in (f"{args.id}.service", f"{args.id}.schedule"):
        for stream in ("out", "err"):
            p = base / f"{suffix}.{stream}"
            if p.exists():
                shown = True
                print(f"\n=== {p.name} (tail) ===")
                lines = p.read_text(errors="replace").splitlines()
                print("\n".join(lines[-args.lines:]))
    if not shown:
        print(f"No logs for '{args.id}' yet. (Run it, or check logs/runs.jsonl.)")
    return 0


def _runtime_cmd(m: manifest_mod.Manifest) -> list[str]:
    if m.runtime == "python":
        return [sys.executable, str(m.entry_path)]
    if m.runtime == "node":
        return ["node", str(m.entry_path)]
    if m.runtime == "claude":
        return _claude_cmd(m)
    raise SystemExit(f"Unsupported runtime: {m.runtime}")


def _claude_cmd(m: manifest_mod.Manifest) -> list[str]:
    """Build a headless Claude invocation: Claude orchestrates the run.

    The prompt is the automation's entry file. Tools are whitelisted from the
    manifest — headless aborts on any unapproved tool, which mechanically
    enforces the data-egress boundary (e.g. finance only exposes the
    aggregate `features` tool, never raw queries).
    """
    prompt = m.entry_path.read_text()
    claude_bin = os.environ.get("AUTO_CLAUDE_BIN", "claude")
    cmd = [claude_bin, "-p", prompt, "--output-format", "json"]
    # Allowed tools: empty list => fully sandboxed (no tools).
    cmd += ["--allowedTools", ",".join(m.allowed_tools)]
    return cmd


def cmd_run(args) -> int:
    m = manifest_mod.get(args.id)

    # Resolve declared secrets once here; inject into child env.
    child_env = os.environ.copy()
    for name in m.secrets:
        value = secrets_store.get(name, required=True)
        child_env[name] = value
    # Make shared lib importable in the child.
    child_env["PYTHONPATH"] = os.pathsep.join(
        [str(LIB_PY), child_env.get("PYTHONPATH", "")]
    ).strip(os.pathsep)

    # Claude-orchestrated runs execute from repo root so whitelisted tool
    # paths (lib/py/...) resolve; code runs from their own folder.
    cwd = REPO_ROOT if m.runtime == "claude" else m.dir

    trigger = "cli" if not args.trigger else args.trigger
    with runlog.record(m.id, trigger):
        result = subprocess.run(_runtime_cmd(m), env=child_env, cwd=str(cwd))
        if result.returncode != 0:
            raise SystemExit(f"Automation '{m.id}' exited with {result.returncode}")
    print(f"[auto] '{m.id}' completed ok.")
    return 0


def cmd_ui(_args) -> int:
    app = REPO_ROOT / "ui" / "app.py"
    if not app.exists():
        print("UI not built yet. Expected ui/app.py")
        return 1
    # Kill any existing dashboard instances so we never accumulate ports.
    subprocess.run(["pkill", "-9", "-f", f"streamlit run {app}"],
                   capture_output=True)
    # Single fixed port, localhost only — never expose finance data (§13.3).
    return subprocess.call([
        "streamlit", "run", str(app),
        "--server.address", "127.0.0.1",
        "--server.port", "8501",
    ])


def cmd_deploy(args) -> int:
    import deploy

    m = manifest_mod.get(args.id)
    if "schedule" not in m.triggers and "service" not in m.triggers:
        print(f"[auto] '{m.id}' has no 'schedule' or 'service' trigger — nothing to deploy.")
        return 1

    if m.deploy_target == "local-cron":
        label, xml, suggested = deploy.launchd_plist(m)
        out = deploy.LAUNCHD_DIR / f"{label}.plist"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(xml)
        print(f"[auto] wrote launchd plist: {out}")
        print("Install (modern launchctl):")
        print(f"  cp {out} {suggested}")
        print(f"  launchctl bootstrap gui/$(id -u) {suggested}")
        print(f"  launchctl enable gui/$(id -u)/{label}")
        print("Remove:")
        print(f"  launchctl bootout gui/$(id -u)/{label}")
        return 0

    if m.deploy_target == "github-actions":
        yaml, note = deploy.actions_workflow(m)
        out = deploy.WORKFLOWS_DIR / f"{m.id}.yml"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(yaml)
        print(f"[auto] wrote workflow: {out}")
        print(f"[auto] note: {note}")
        print(f"[auto] add these repo secrets in Settings → Actions: {', '.join(m.secrets) or '(none)'}")
        return 0

    print(f"[auto] deploy.target '{m.deploy_target}' is not deployable (use local-cron or github-actions).")
    return 1


def cmd_skills(_args) -> int:
    import skillgen

    manifests = manifest_mod.discover()
    written = skillgen.generate_all(manifests)
    if not written:
        print("[auto] no automations declare the 'skill' trigger.")
        return 0
    for p in written:
        print(f"[auto] generated skill: /{p.parent.name}  ({p})")
    print("Restart Claude Code if the .claude/skills/ dir is new; otherwise picked up live.")
    return 0


def cmd_update(args) -> int:
    """Apply latest code: pull (if a git remote exists), regenerate skills, and
    reinstall/restart all managed services so they run the new code."""
    import service

    # Optional git pull — only if a remote is configured.
    remote = subprocess.run(["git", "remote"], cwd=str(REPO_ROOT),
                            capture_output=True, text=True).stdout.strip()
    if remote and not args.no_pull:
        print("[auto] git pull…")
        subprocess.run(["git", "pull", "--ff-only"], cwd=str(REPO_ROOT))

    cmd_skills(args)

    managed = [m for m in manifest_mod.discover() if m.managed]
    if args.category:
        managed = [m for m in managed if m.category == args.category]
    print(f"[auto] restarting {len(managed)} service(s) on latest code…")
    for m in managed:
        if service.is_loaded(m.id):           # only restart ones already running
            ok, err = service.install(m)
            print(f"  {'✅' if ok else '⚠️ '} {m.id}")
    print("[auto] UI: run `auto ui` to relaunch the dashboard on the latest code.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="auto")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_list = sub.add_parser("list", help="list automations (grouped by category)")
    p_list.add_argument("--category", default=None)
    p_list.set_defaults(func=cmd_list)

    p_status = sub.add_parser("status", help="show service state + last run")
    p_status.add_argument("--category", default=None)
    p_status.set_defaults(func=cmd_status)

    p_run = sub.add_parser("run", help="run an automation now")
    p_run.add_argument("id")
    p_run.add_argument("--trigger", default=None,
                       help="Override the trigger label recorded in logs.")
    p_run.set_defaults(func=cmd_run)

    for name, fn, helptext in [
        ("start", cmd_start, "install+start service(s): <id>, <category>, or all"),
        ("stop", cmd_stop, "stop service(s): <id>, <category>, or all"),
        ("restart", cmd_restart, "restart service(s): <id>, <category>, or all"),
    ]:
        p = sub.add_parser(name, help=helptext)
        p.add_argument("target", help="automation id, category name, or 'all'")
        p.set_defaults(func=fn)

    p_logs = sub.add_parser("logs", help="tail an automation's service/schedule logs")
    p_logs.add_argument("id")
    p_logs.add_argument("--lines", type=int, default=30)
    p_logs.set_defaults(func=cmd_logs)

    sub.add_parser("ui", help="launch the dashboard (localhost:8501)").set_defaults(func=cmd_ui)

    p_dep = sub.add_parser("deploy", help="generate a schedule trigger (advanced)")
    p_dep.add_argument("id")
    p_dep.set_defaults(func=cmd_deploy)

    sub.add_parser("skills", help="(re)generate Claude Code skills").set_defaults(func=cmd_skills)

    p_up = sub.add_parser("update", help="apply latest code: pull + skills + restart services")
    p_up.add_argument("--category", default=None)
    p_up.add_argument("--no-pull", action="store_true")
    p_up.set_defaults(func=cmd_update)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
